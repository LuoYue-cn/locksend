{
    "name": "locksend/server",
    "description": "LockSend server: E2EE anonymous file sharing (ciphertext store only)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "ext-pdo": "*",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": { "LockSend\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "LockSend\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
