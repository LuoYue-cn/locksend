<?xml version="1.0"?>
<ruleset name="LockSend">
    <description>PSR-12 for all code; tests may carry long fixture lines.</description>
    <rule ref="PSR12"/>
    <file>src</file>
    <file>bin</file>
    <file>public/index.php</file>
    <file>tests</file>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
